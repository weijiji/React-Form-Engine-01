# Server
NODE_ENV=development
SERVER_PORT=3001

# Database
# NOTE: host is `localhost` for local (non-Docker) development.
# Docker Compose overrides this with `@postgres` (see docker-compose.yml).
DATABASE_URL=postgresql://form_engine:form_engine_pass@localhost:5432/form_engine_db
POSTGRES_USER=form_engine
POSTGRES_PASSWORD=form_engine_pass
POSTGRES_DB=form_engine_db

# JWT
JWT_SECRET=change-me-in-production-use-a-strong-random-string
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# CSRF
CSRF_COOKIE_NAME=xsrf-token

# Logging
LOG_LEVEL=info

# NL 表单生成（ADR-0013）
# 可选：未配置 ANTHROPIC_API_KEY 时，NL 生成降级到本地规则引擎；refine 无 key 时 503。
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
